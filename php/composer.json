{
    "name": "axioapi/axioapi",
    "description": "PHP client for the AxioAPI REST API: temp mail, SMS and OTP, email validation, proxies, SEO and backlink data, social scrapers.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://axioapi.com",
    "keywords": ["api", "seo api", "backlink api", "temp mail api", "sms verification api", "proxy api", "scraper api"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "AxioAPI\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AxioAPI\\Tests\\": "tests/" }
    },
    "scripts": { "test": "phpunit" }
}
