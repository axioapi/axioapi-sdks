{
    "name": "axioapi/axioapi",
    "description": "Official PHP SDK for the AxioAPI REST API: temp mail API, receive SMS and OTP API, email validation API, proxy API, SEO API (keyword data and backlink API), search API and social scraper APIs. One API key.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://axioapi.com",
    "keywords": ["api", "sdk", "seo api", "backlink api", "keyword api", "temp mail api", "sms verification api", "otp api", "email validation api", "proxy api", "scraper api", "search api", "serp api", "scholar api", "translation api", "php", "axioapi"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "AxioAPI\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AxioAPI\\Tests\\": "tests/" }
    },
    "scripts": { "test": "phpunit" }
}
