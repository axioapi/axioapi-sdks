<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AxioAPI</RootNamespace>
    <PackageId>AxioAPI</PackageId>
    <Version>1.0.0</Version>
    <Description>Official C# and .NET SDK for the AxioAPI REST API: temp mail API, receive SMS and OTP API, email validation API, proxy API, SEO API (keyword data and backlink API), search API and social scraper APIs. One API key.</Description>
    <PackageTags>api;sdk;seo-api;backlink-api;keyword-api;temp-mail-api;sms-verification-api;otp-api;email-validation-api;proxy-api;scraper-api;search-api;serp-api;scholar-api;translation-api;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://axioapi.com</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="operations.json" LogicalName="AxioAPI.operations.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
